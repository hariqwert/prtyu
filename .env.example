# OPENROUTER_API_KEY: Primary AI routing engine key
OPENROUTER_API_KEY=""

# GEMINI_API_KEY: Secondary fallback for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Admin Credentials
ADMIN_USER=admin
# Default hash for "password" (bcrypt)
ADMIN_PASS_HASH=$2y$10$YourBcryptHashGoesHereForSecurityPurposesxyz
SESSION_SECRET=your_randomly_generated_session_secret_here

# TMDB Configuration
# Multiple keys separated by comma for automatic rotation
TMDB_API_KEYS="your_tmdb_key_1,your_tmdb_key_2,your_tmdb_key_3"
TMDB_API_KEY="your_primary_tmdb_key"


# --- Outbound / Residential / Indian VPN Exit Proxy for Geo-Restricted Live Streams (Optional) ---
# Supports HTTP, HTTPS, SOCKS5, and SOCKS4 Indian VPN/proxy egress nodes:
# INDIAN_VPN_PROXY_URL=socks5://username:password@indian-vpn-exit-node:1080
# RESIDENTIAL_PROXY_URL=http://user:pass@indian-residential-proxy:port
# INDIAN_PROXY_URL=socks5://127.0.0.1:1080
# OUTBOUND_PROXY_URL=http://user:pass@proxy-host:port

# --- YouTube Downloading Bot Protection Bypasses (Optional) ---
# Solution 1: Egress Proxy (Residential / VPS Tunnel)
# YOUTUBE_PROXY_URL=http://username:password@proxy-host:port

# Solution 2: Automated PoToken & Visitor Data (For datacenter bypassing)
